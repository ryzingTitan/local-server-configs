[Unit]
Description=Qwen2.5-Coder 3B model via llama.cpp
After=network.target

[Service]
Type=simple
User=kstoltzfus
Group=kstoltzfus
WorkingDirectory=/home/kstoltzfus/llama-models

ExecStart=/usr/bin/snap run llama-cpp server -m Qwen2.5-Coder-3B-Instruct-Q4_K_M.gguf --alias "qwen2.5-coder:3b" -t 4 -c 16384 --cache-type-k q8_0 --cache-type-v q8_0 --host 0.0.0.0 --port 8093

Restart=on-failure
RestartSec=5

# Keep logs in the systemd journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target