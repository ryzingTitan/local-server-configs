[Unit]
Description=llama.cpp Router (multi-model server)
After=network.target

[Service]
Type=simple
User=kstoltzfus
Group=kstoltzfus
WorkingDirectory=/home/kstoltzfus/llama-models

ExecStart=/usr/bin/snap run llama-cpp server --models-preset /home/kstoltzfus/llama-models/models.ini --models-max 1 --host 0.0.0.0 --port 8095

Restart=on-failure
RestartSec=5

# Keep logs in the systemd journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target